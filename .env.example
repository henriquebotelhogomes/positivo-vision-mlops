# ==============================================================================
# 🏭 Positivo Vision MLOps - Configurações de Ambiente (.env.example)
# ==============================================================================

# Aplicação & Servidor
APP_NAME="Positivo Vision MLOps"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# Rate Limiting & FinOps Guardrails
RATE_LIMIT_INFERENCE="25/2hours"
RATE_LIMIT_REPORT="10/2hours"
ADMIN_BYPASS_KEY="positivo_audit_bypass_key_2026"

# LLM Industrial (OpenCode Go - Causa-Raiz SMT)
OPENCODE_BASE_URL="https://api.opencode.go/v1"
OPENCODE_API_KEY=""
OPENCODE_MODEL="DeepSeek V4.1 Flash"

# MLOps & Governança (MLflow)
MLFLOW_TRACKING_URI="sqlite:///mlflow.db"
MLFLOW_EXPERIMENT_NAME="positivo-pcb-inspection"

# Model Artifacts & Borda ONNX
MODEL_PATH="models/champion.onnx"
MODEL_ALIAS="@champion"
DATA_SAMPLE_POOL_DIR="data/sample_pool"
DATA_TELEMETRY_DIR="data/telemetry"
